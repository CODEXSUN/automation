NODE_ENV=development
AUTOMATION_HOST=127.0.0.1
AUTOMATION_PORT=4395
AUTOMATION_LOG_LEVEL=info
AUTOMATION_SHUTDOWN_TIMEOUT_MS=10000

AUTOMATION_WEB_PORT=4390

# Required local job storage and disposable test storage; keep real values in ignored .env.
# Overview reports presence; /api/ready checks the audit table.
AUTOMATION_DATABASE_URL=
AUTOMATION_TEST_DATABASE_URL=
# Optional and currently unused by the PostgreSQL audit queue.
AUTOMATION_REDIS_URL=
# Standalone development only: absolute path to the agreed governance document.
# AUTOMATION_GOVERNANCE_PATH=
